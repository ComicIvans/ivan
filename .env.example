# Settings the app itself reads. Copy this file to .env:
# - locally, `pnpm dev` and `pnpm build` load it;
# - on the server, docker-compose.yml passes it to the container (env_file).
#
# Deploy settings (VPS host, registry token, image build args) live in
# .env.deploy instead (see .env.deploy.example), so they never reach the
# running container. On the server, .env needs only the RUNTIME block.

# ─────────────────────────────────────────────────────────────
# BUILD (local `pnpm dev` / `pnpm build`; the deploy scripts take these
# values from .env.deploy and bake them into the Docker image)
# ─────────────────────────────────────────────────────────────

# Application
SITE_URL=https://tusitio.example.com

# Analytics
NUXT_UMAMI_HOST=https://analytics.example.com
NUXT_UMAMI_ID=00000000-0000-0000-0000-000000000000

# Optional: directory for the server's writable data (Nuxt Content database
# and rate-limit records). NOTE: read at build time (baked into the build),
# NOT a runtime override. The Docker image always builds with /data (its
# persistent volume); other builds default to .data/production in the project.
# DATA_DIR=/data

# ─────────────────────────────────────────────────────────────
# RUNTIME (provided to the running container via docker-compose env_file)
# ─────────────────────────────────────────────────────────────

# Mail
# NUXT_-prefixed because Nuxt only overrides runtimeConfig from env vars with
# that prefix at runtime. Plain SMTP_* names are silently ignored in production.
# NUXT_SMTP_SECURE=true: implicit TLS (usually port 465). With false (usually
# port 587) the server must offer STARTTLS, or sending fails rather than going
# out unencrypted; only a relay on localhost/127.0.0.1/::1 may run without TLS.
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=usuario_ejemplo
NUXT_SMTP_PASS=contraseña_ejemplo
NUXT_SMTP_FROM_EMAIL=remitente@example.com
NUXT_SMTP_TO_EMAIL=destinatario@example.com

# Root secret for signed URLs (Nuxt runtimeConfig.appSecret). Required in
# production: without it every /_og/* social preview image returns 500 and the
# rate limiter keys its records with a per-process key (counters restart with
# every start); the server logs a [config] error at startup.
# At least 32 characters; never commit a real value. Generate one with
# `openssl rand -base64 32` (keep it the same across deploys so shared preview
# URLs stay valid).
NUXT_APP_SECRET=

# Search-engine indexability at runtime. docker-compose.yml defaults it to
# true; set it to false for staging/preview deployments that must stay out of
# search results.
# NUXT_SITE_INDEXABLE=true
