# Deployment settings for deploy.sh (pnpm deploy:vps) and deploy-local.sh
# (pnpm deploy:local). Copy this file to .env.deploy on the machine that runs
# the deploys. The scripts load it as a shell file: keep plain KEY=VALUE lines.
#
# Nothing here reaches the running container: docker-compose.yml only passes
# .env (the runtime settings, see .env.example) to the app.

# ─────────────────────────────────────────────────────────────
# IMAGE BUILD (baked into the Docker image as build args)
# ─────────────────────────────────────────────────────────────

# Canonical public URL of the site.
SITE_URL=https://tusitio.example.com

# Optional analytics (self-hosted Umami). Leave both empty to build without it.
NUXT_UMAMI_HOST=https://analytics.example.com
NUXT_UMAMI_ID=00000000-0000-0000-0000-000000000000

# Optional: image name and target platform. The scripts also pass IMAGE to
# docker compose, so the container always runs the image they built.
# IMAGE=ghcr.io/comicivans/ivan:latest
# DOCKER_PLATFORM=linux/amd64

# ─────────────────────────────────────────────────────────────
# VPS (deploy.sh only)
# ─────────────────────────────────────────────────────────────

# SSH destination and the absolute directory that holds the runtime .env.
# deploy.sh copies docker-compose.yml there on every deploy.
VPS_HOST=usuario@vps.example.com
REMOTE_DIR=/ruta/remota/ejemplo

# GHCR credentials for pushing (local) and pulling (VPS) the private image.
# Without them the VPS `docker compose pull` fails with "denied". Use a GitHub
# PAT with write:packages (push) and read:packages (pull). Alternatively run
# `docker login ghcr.io` once on each machine and leave both empty.
GHCR_USERNAME=tu-usuario-github
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
